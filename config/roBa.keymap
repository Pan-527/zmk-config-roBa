#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/modifiers.h>
#include <dt-bindings/zmk/pointing.h>
#include <input/processors.dtsi>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    // automouse-layer = <4>;

    // スクロールはドライバではなく下の &trackball_listener (scroller) で処理するので
    // ドライバ側の scroll-layers は使わない (有効にすると慣性スクロールが効かなくなる)。
    // scroll-layers = <5>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

// ---------------------------------------------------------------------------
// 慣性スクロール (mjmjm0101/zmk-input-processor-scroll-inertia)
// SCROLL レイヤー (5) でボールを弾いて離すと、スクロールが減衰しながら続く。
// ---------------------------------------------------------------------------
&scroll_inertia {
    layer = <5>;      // SCROLL レイヤー番号。レイヤーを離した瞬間に慣性も止まる

    // 1 = 縦スクロールのみ (横方向の成分は縦に合成される)
    // 0 = 縦横自由 (斜めにも流れる), 2 = 横のみ
    axis = <1>;

    // Shift を押している間だけ横スクロールになる
    swap-mod = <(MOD_LSFT | MOD_RSFT)>;

    // 後段の zip_scroll_scaler の引数 (1 20) と必ず同じ値にする。
    // 20 カウント (約 0.6mm) で 1 ノッチ。小さな回転にもすぐ反応する比率。
    // スクロール量を変えるときは scale-div と zip_scroll_scaler の第 2 引数を
    // 同時に変える (小さいほど速い)。
    scale = <1>;
    scale-div = <20>;

    // フリック判定のしきい値 (モジュール既定は start 40 / move 80)。
    // 弱いフリックでも慣性が付くように低めにしている。
    // ゆっくりスクロールしただけで慣性が付く → 両方を上げる
    // ちゃんと弾いても慣性が付かない → 両方を下げる
    start = <14>;     // ピーク速度 (カウント/フレーム)
    move = <40>;      // フリック中の合計移動量 (カウント)

    // 短いフリックを拾うために、慣性が付く前に必要なイベント数を減らしている (既定 10)
    min-events = <5>;

    // 「離した」と判定する減速の度合い (既定 850 = ピークの 85% 未満)。
    // 低くすると、ゆっくり回して減速しただけでは慣性が付かず、本当に離したときだけ付く。
    decel-ratio = <750>;

    // 慣性が止まる速度。scale 1 / scale-div 20 なら 1 前後が目安
    // (下げると末尾がカクつくので、末尾が気になるときは上げる)
    stop = <1>;

    // 減衰の強さ (既定 990): 995 にすると長く滑り、980 にすると早く止まる
    decay-fast = <993>;
    decay-slow = <993>;
    decay-tail = <993>;
    // 小さなフリックのブレーキ (既定 35): 上げる (例 100) と小さなフリックが早めに止まる
    friction = <25>;
};

// ---------------------------------------------------------------------------
// トラックボールジェスチャー (zettaface/zmk-input-processor-keybind)
// GESTURE レイヤー (7, J 長押し) でボールを弾くと方向に応じたキーを送る。
// 左右 (trackball_gesture) と上下 (trackball_gesture_v) は別のプロセッサで判定する。
//   左右: J を押している間は何度でも発火する (右→左の往復ができる)
//   上下: J を押している間に 1 回だけ発火する (Mission Control はトグルなので
//         2 回発火すると開いてすぐ閉じてしまうため)。発火後は GESTURE_DONE
//         レイヤー (8) が有効になって上下だけ無視され、J を離すと解除される。
// ---------------------------------------------------------------------------
&trackball_gesture {
    mode = <1>;       // 0 = 生の XY, 1 = 上下左右の 4 方向判定, 2 = 斜め込みの 8 方向判定

    // 順番は 右, 左, 上, 下。上下はこちらでは扱わない (&none)
    bindings = <&kp LC(LEFT_ARROW)>,    // 右: 前のデスクトップ (トラックパッドのスワイプと同じ向き)
               <&kp LC(RIGHT_ARROW)>,   // 左: 次のデスクトップ
               <&none>,
               <&none>;

    tick = <300>;     // 1 回発火するのに必要な移動量 (カウント)。小さくすると敏感になる
    tap-ms = <30>;    // キーを押してから離すまでの時間
    wait-ms = <0>;    // 連続発火の間隔 (大きくすると発火中に処理が止まるので 0 推奨)
    threshold = <0>;  // 0 にしないと横方向のみの動きが取りこぼされる
    max_threshold = <2000>;         // これより大きい 1 フレームの動きは無視
    max_pending_activations = <1>;  // 1 回のフリックで溜め込む発火数
};

&trackball_gesture_v {
    mode = <1>;

    // 順番は 右, 左, 上 (ボールを奥へ), 下 (ボールを手前へ)。左右はこちらでは扱わない (&none)
    // 上下が逆になる場合は 3 つ目と 4 つ目を入れ替える。
    // 割り当てを変えるときは macros 内の gesture_up / gesture_down を編集する
    bindings = <&none>,
               <&none>,
               <&gesture_up>,     // 上: Mission Control
               <&gesture_down>;   // 下: アプリケーション Expose

    tick = <300>;     // 判定前に縦方向を 4 倍しているので、実際は 75 カウントで発火する
    tap-ms = <30>;
    wait-ms = <0>;
    threshold = <0>;
    max_threshold = <2000>;         // 縦は 4 倍された値で比較される
    max_pending_activations = <1>;
};

// ---------------------------------------------------------------------------
// レイヤーごとのトラックボール処理
// 該当レイヤーが有効な間はデフォルトのカーソル移動の代わりにこちらが使われる。
// ---------------------------------------------------------------------------
&trackball_listener {
    scroller {
        layers = <5>;   // SCROLL レイヤー
        input-processors = <
            &zip_y_scaler (-1) 1          // 縦方向の反転 (逆にしたい場合は 1 1)
            &zip_xy_to_scroll_mapper      // XY の動きをホイール入力へ変換
            &scroll_inertia               // 慣性
            &zip_scroll_scaler 1 20       // スクロール速度 (20 カウントで 1 ノッチ)。&scroll_inertia の scale / scale-div と合わせる
        >;
    };

    // 注意: ZMK の input-listener は、レイヤー別チェーンのプロセッサが STOP を返しても
    // それを無視してイベントを HID に流してしまう。そのためカーソルを止めるには
    // 「捨てる」のではなく、&zip_xy_scaler 0 1 で移動量を 0 に書き換える必要がある。

    // 各チェーンは上から順に評価され、process-next の付いたものは次にも流れる。
    // 上下ジェスチャー発火後 (レイヤー 8 が有効): 左右判定だけ行い、移動量を 0 にする。
    gesture_done_h {
        layers = <8>;   // GESTURE_DONE レイヤー
        process-next;
        input-processors = <&trackball_gesture>;
    };

    gesture_done_guard {
        layers = <8>;
        input-processors = <&zip_xy_scaler 0 1>;
    };

    // J を押している間 (1/3): 左右ジェスチャー判定 (縦方向は等倍のまま)。
    gesture_h {
        layers = <7>;   // GESTURE レイヤー
        process-next;
        input-processors = <&trackball_gesture>;
    };

    // J を押している間 (2/3): 上下ジェスチャー判定。
    gesture_v {
        layers = <7>;
        process-next;
        input-processors = <
            &zip_y_scaler 4 1       // 縦方向の動きを 4 倍にして判定に渡す (親指は縦に大きく動かしにくいため)。
                                    // 実質 tick÷4 で発火する。縦が敏感すぎれば 3 1 や 2 1 にする
            &trackball_gesture_v
        >;
    };

    // J を押している間 (3/3): 判定が終わった後の移動量を 0 にしてカーソルを止める。
    // J を離した瞬間に通常のカーソル操作に戻る。
    gesture_guard {
        layers = <7>;
        input-processors = <&zip_xy_scaler 0 1>;
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        screen_shot {
            bindings = <&kp LS(LC(LG(NUMBER_4)))>;
            key-positions = <11 13>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
        };

        tab {
            bindings = <&to_layer_0 TAB>;
            key-positions = <11 12>;
        };

        shift_command {
            bindings = <&kp LS(LEFT_COMMAND)>;
            key-positions = <18 20>;
        };

        left_click {
            bindings = <&mkp LCLK>;
            key-positions = <18 19>;
        };

        right_click {
            bindings = <&mkp RCLK>;
            key-positions = <19 20>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        // J 長押し用: 押している間 GESTURE レイヤー (7) を有効にし、
        // 離したときに GESTURE レイヤーと GESTURE_DONE レイヤー (8) の両方を解除する。
        gesture_hold: gesture_hold {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_press &mo 7>,
                       <&macro_pause_for_release>,
                       <&macro_release &mo 7>,
                       <&macro_release &mo 8>;
            label = "GESTURE_HOLD";
        };

        // 上下ジェスチャー: キーを送ってから GESTURE_DONE レイヤー (8) を有効にし、
        // J を離すまで上下の再発火を止める
        gesture_up: gesture_up {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <30>;
            bindings = <&macro_tap &kp LC(UP_ARROW)>, <&macro_press &mo 8>;
            label = "GESTURE_UP";
        };

        gesture_down: gesture_down {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <30>;
            bindings = <&macro_tap &kp LC(DOWN_ARROW)>, <&macro_press &mo 8>;
            label = "GESTURE_DOWN";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        // ジェスチャーレイヤー用の layer-tap。
        // - tapping-term-ms: これ以上押し続けるとジェスチャーレイヤーになる。
        //   短くすると「じ」と打つときに j が落ちやすくなるので 200 前後が目安。
        // - require-prior-idle-ms: 直前にこの時間以内に別のキーを打っていたら
        //   必ず文字 (タップ) として扱う。文章を打っている最中に長押し扱いになるのを防ぐ。
        //   ジェスチャーは手を止めてから J を押せば効く。
        // 使い方: &lt_gesture 0 J (最初の引数は使わないので 0)
        lt_gesture: lt_gesture {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_GESTURE";
            bindings = <&gesture_hold>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <125>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W             &kp E         &kp R                          &kp T                                          &kp Y              &kp U  &kp I      &kp O       &kp P
&kp A             &kp S             &kp D         &kp F                          &kp G        &kp SEMICOLON      &kp SEMI       &kp H              &lt_gesture 0 J  &lt 5 K    &kp L       &kp ENTER
&mt LEFT_SHIFT Z  &kp X             &kp C         &kp V                          &kp B        &kp EQUAL          &kp MINUS      &kp N              &kp M  &kp COMMA  &kp PERIOD  &mt RIGHT_SHIFT SLASH
&kp GRAVE         &kp LEFT_CONTROL  &kp LEFT_ALT  &lt_to_layer_0 2 LEFT_COMMAND  &lt 3 SPACE  &lt 1 TAB          &kp BACKSPACE  &kp RIGHT_COMMAND                                &lt 6 DEL
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        FUNCTION {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans   &trans   &trans
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6      &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                            &trans
            >;
        };

        NUM {
            bindings = <
&kp MINUS          &kp N7        &kp N8        &kp N9        &kp PLUS                          &kp PERCENT       &kp CARET          &kp AMPERSAND   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&kp SLASH          &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp ASTERISK  &trans      &trans  &kp EXCLAMATION   &kp AT_SIGN        &kp HASH        &kp DOLLAR            &trans
&mt LEFT_SHIFT N0  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp PERIOD    &trans      &trans  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_BRACE  &kp RIGHT_BRACE       &kp BACKSLASH
&trans             &trans        &trans        &trans        &trans        &trans      &trans  &trans                                                                     &kp PIPE
            >;
        };

        ARROW {
            bindings = <
&kp ESCAPE      &kp LC(LS(TAB))         &kp UP_ARROW    &kp LC(TAB)              &trans                       &trans  &trans  &trans  &trans  &trans
&kp HOME        &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp END  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&kp LEFT_SHIFT  &kp LG(LS(LEFT_ARROW))  &trans          &kp LG(LS(RIGHT_ARROW))  &trans   &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans          &trans                  &trans          &trans                   &trans   &trans      &trans  &trans                          &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans              &kp LC(UP_ARROW)    &trans               &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &kp LC(LEFT_ARROW)  &kp LC(DOWN_ARROW)  &kp LC(RIGHT_ARROW)  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans              &trans              &trans               &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans              &trans              &trans               &trans  &trans      &trans  &trans                          &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans        &trans        &trans        &trans                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans        &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans      &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans                                                  &bt BT_CLR_ALL
            >;
        };

        GESTURE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        // 上下ジェスチャー発火後、J を離すまで上下を無視するためのレイヤー (キーは全て透過)
        GESTURE_DONE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };
    };
};
