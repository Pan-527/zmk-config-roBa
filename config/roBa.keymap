#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/modifiers.h>
#include <dt-bindings/zmk/pointing.h>
#include <input/processors.dtsi>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    // automouse-layer = <4>;

    // スクロールはドライバではなく下の &trackball_listener (scroller) で処理するので
    // ドライバ側の scroll-layers は使わない (有効にすると慣性スクロールが効かなくなる)。
    // scroll-layers = <5>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

// ---------------------------------------------------------------------------
// 慣性スクロール (mjmjm0101/zmk-input-processor-scroll-inertia)
// SCROLL レイヤー (5) でボールを弾いて離すと、スクロールが減衰しながら続く。
// ---------------------------------------------------------------------------
&scroll_inertia {
    layer = <5>;      // SCROLL レイヤー番号。レイヤーを離した瞬間に慣性も止まる

    // 1 = 縦スクロールのみ (横方向の成分は縦に合成される)
    // 0 = 縦横自由 (斜めにも流れる), 2 = 横のみ
    axis = <1>;

    // Shift を押している間だけ横スクロールになる
    swap-mod = <(MOD_LSFT | MOD_RSFT)>;

    // 後段の zip_scroll_scaler の引数 (1 16) と必ず同じ値にする
    scale = <1>;
    scale-div = <16>;

    // フリック判定のしきい値 (値を下げると軽い動きでも慣性が付く)
    // モジュールの既定値は start 40 / move 80 だが、トラックパッドのように
    // 弱いフリックでも慣性が付くようにかなり低くしている。
    // ゆっくりスクロールしただけで慣性が付いてしまうなら両方を 1.5〜2 倍にする。
    start = <10>;     // ピーク速度 (カウント/フレーム)
    move = <20>;      // フリック中の合計移動量 (カウント)

    // 短いフリックでも慣性が付くように、判定に必要なフレーム数を減らしている
    min-events = <4>;     // 既定 10。慣性が付く前に必要なイベント数
    decel-samples = <2>;  // 既定 3。「離した」と判定するまでの減速フレーム数

    // 慣性が止まる速度。scale 1 / scale-div 16 なら 1 前後が目安
    stop = <1>;

    // 減衰の強さ: decay-* を 990 → 995 にすると長く滑り、980 にすると早く止まる
    // friction を上げる (例 100) と小さなフリックが早めに止まる
    friction = <20>;  // 既定 35。小さなフリックも少し長く滑らせる
    // decay-fast = <990>;
    // decay-slow = <990>;
    // decay-tail = <990>;
};

// ---------------------------------------------------------------------------
// トラックボールジェスチャー (zettaface/zmk-input-processor-keybind)
// GESTURE レイヤー (7, J 長押し) でボールを弾くと方向に応じたキーを送る。
// ---------------------------------------------------------------------------
&trackball_gesture {
    mode = <1>;       // 0 = 生の XY, 1 = 上下左右の 4 方向判定, 2 = 斜め込みの 8 方向判定

    // 順番は 右, 左, 上 (ボールを奥へ), 下 (ボールを手前へ)
    // 上下が逆になる場合は 3 つ目と 4 つ目を入れ替える
    bindings = <&kp LC(RIGHT_ARROW)>,   // 右: 次のデスクトップ
               <&kp LC(LEFT_ARROW)>,    // 左: 前のデスクトップ
               <&kp LC(UP_ARROW)>,      // 上: Mission Control
               <&kp LC(DOWN_ARROW)>;    // 下: アプリケーション Expose

    tick = <300>;     // 1 回発火するのに必要な移動量 (カウント)。小さくすると敏感になる
    tap-ms = <30>;    // キーを押してから離すまでの時間
    wait-ms = <0>;    // 連続発火の間隔 (大きくすると発火中に処理が止まるので 0 推奨)
    threshold = <0>;  // 0 にしないと横方向のみの動きが取りこぼされる
    max_threshold = <500>;          // これより大きい 1 フレームの動きは無視
    max_pending_activations = <1>;  // 1 回のフリックで溜め込む発火数
};

// ジェスチャー後の待機用。ボールの動きを何にも変換せず捨てるだけ。
&trackball_sink {
    bindings = <&none>, <&none>, <&none>, <&none>;
    tick = <30000>;   // 発火しないように十分大きくする
    threshold = <0>;
    max_threshold = <30000>;
    max_pending_activations = <1>;
};

// ---------------------------------------------------------------------------
// レイヤーごとのトラックボール処理
// 該当レイヤーが有効な間はデフォルトのカーソル移動の代わりにこちらが使われる。
// ---------------------------------------------------------------------------
&trackball_listener {
    scroller {
        layers = <5>;   // SCROLL レイヤー
        input-processors = <
            &zip_y_scaler (-1) 1          // 縦方向の反転 (逆にしたい場合は 1 1)
            &zip_xy_to_scroll_mapper      // XY の動きをホイール入力へ変換
            &scroll_inertia               // 慣性
            &zip_scroll_scaler 1 16       // スクロール速度 (16 カウントで 1 ノッチ)
        >;
    };

    // J を押している間: ジェスチャー判定。
    // 同時に GESTURE_SETTLE レイヤー (8) を「最後のボール入力から 500ms」だけ有効にする。
    gesture {
        layers = <7>;   // GESTURE レイヤー
        input-processors = <
            &zip_temp_layer 8 500
            &trackball_gesture
        >;
    };

    // J を離した後、ボールが惰性で回っている間はここに入り、動きを捨てる。
    // ボールが止まって 500ms 経つとレイヤー 8 が外れて通常のカーソル操作に戻る。
    // 惰性で回る時間が長くてカーソルが動くなら 500 を大きくする。
    gesture_settle {
        layers = <8>;   // GESTURE_SETTLE レイヤー
        input-processors = <
            &zip_temp_layer 8 500
            &trackball_sink
        >;
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        screen_shot {
            bindings = <&kp LS(LC(LG(NUMBER_4)))>;
            key-positions = <11 13>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
        };

        tab {
            bindings = <&to_layer_0 TAB>;
            key-positions = <11 12>;
        };

        shift_command {
            bindings = <&kp LS(LEFT_COMMAND)>;
            key-positions = <18 20>;
        };

        left_click {
            bindings = <&mkp LCLK>;
            key-positions = <18 19>;
        };

        right_click {
            bindings = <&mkp RCLK>;
            key-positions = <19 20>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W             &kp E         &kp R                          &kp T                                          &kp Y              &kp U  &kp I      &kp O       &kp P
&kp A             &kp S             &kp D         &kp F                          &kp G        &kp SEMICOLON      &kp SEMI       &kp H              &lt 7 J  &lt 5 K    &kp L       &kp ENTER
&mt LEFT_SHIFT Z  &kp X             &kp C         &kp V                          &kp B        &kp EQUAL          &kp MINUS      &kp N              &kp M  &kp COMMA  &kp PERIOD  &mt RIGHT_SHIFT SLASH
&kp GRAVE         &kp LEFT_CONTROL  &kp LEFT_ALT  &lt_to_layer_0 2 LEFT_COMMAND  &lt 3 SPACE  &lt 1 TAB          &kp BACKSPACE  &kp RIGHT_COMMAND                                &lt 6 DEL
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        FUNCTION {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans   &trans   &trans
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6      &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                            &trans
            >;
        };

        NUM {
            bindings = <
&kp MINUS          &kp N7        &kp N8        &kp N9        &kp PLUS                          &kp PERCENT       &kp CARET          &kp AMPERSAND   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&kp SLASH          &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp ASTERISK  &trans      &trans  &kp EXCLAMATION   &kp AT_SIGN        &kp HASH        &kp DOLLAR            &trans
&mt LEFT_SHIFT N0  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp PERIOD    &trans      &trans  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_BRACE  &kp RIGHT_BRACE       &kp BACKSLASH
&trans             &trans        &trans        &trans        &trans        &trans      &trans  &trans                                                                     &kp PIPE
            >;
        };

        ARROW {
            bindings = <
&kp ESCAPE      &kp LC(LS(TAB))         &kp UP_ARROW    &kp LC(TAB)              &trans                       &trans  &trans  &trans  &trans  &trans
&kp HOME        &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp END  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&kp LEFT_SHIFT  &kp LG(LS(LEFT_ARROW))  &trans          &kp LG(LS(RIGHT_ARROW))  &trans   &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans          &trans                  &trans          &trans                   &trans   &trans      &trans  &trans                          &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans              &kp LC(UP_ARROW)    &trans               &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &kp LC(LEFT_ARROW)  &kp LC(DOWN_ARROW)  &kp LC(RIGHT_ARROW)  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans              &trans              &trans               &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans              &trans              &trans               &trans  &trans      &trans  &trans                          &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans        &trans        &trans        &trans                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans        &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans      &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans                                                  &bt BT_CLR_ALL
            >;
        };

        GESTURE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        // ジェスチャー後にボールの惰性回転を無視するための一時レイヤー (キーは全て透過)
        GESTURE_SETTLE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };
    };
};
